{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true
      }
    }
  },
  "managedDependency": {
    "enabled": true
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:05:00"
    }
  }
}
